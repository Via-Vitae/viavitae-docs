# viavitae-docs .gitignore
# Hugo + Node + Python superset for the docs repository.
#
# Never un-ignore a secret, key, state file or environment file.

# --- Secrets and credentials -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets.baseline

# --- Hugo build output -------------------------------------------------------
public/
resources/
.hugo_build.lock

# --- Node and frontend -------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnp.*
*.tsbuildinfo
.eslintcache
.stylelintcache

# --- Build artefacts ---------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python (validation scripts) ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# --- Editors and IDEs --------------------------------------------------------
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Operating systems -------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Archives and large binaries ---------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# --- Local staging and scratch -----------------------------------------------
/.docs-staging/
/.qoder/
